<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree view for author-->
        <record id="view_library_author_tree" model="ir.ui.view">
            <field name="name">library.author.tree</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="country" />
                    <field name="birth_date" />
                    <field name="death_date" />
                    <field name="books_count" />
                </tree>
            </field>
        </record>

        <!-- Form view for author-->
        <record id="view_library_author_form" model="ir.ui.view">
            <field name="name">library.author.form</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Author Name" />
                            </h1>
                        </div>
                        <group>
                            <field name="birth_date" />
                            <field name="death_date" />
                            <field name="country" />
                        </group>
                        <group>
                            <field name="partner_id" />
                            <field name="active" />
                        </group>
                        <notebook>
                            <page string="Biography">
                                <field name="biography" placeholder="Brief biographical information" />
                            </page>
                            <page string="Books" attrs="{'invisible': [('books_count', '=', 0)]}">
                                <field name="book_ids" />
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="message_ids" widget="mail_thread" />
                        <field name="activity_ids" widget="mail_activity" />
                    </div>
                </form>
            </field>
        </record>

        <!-- Search view (Filters) for author-->
        <record id="view_library_author_search" model="ir.ui.view">
            <field name="name">library.author.search</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="country" />
                    <separator />
                    <filter string="Living Authors" name="living"
                        domain="[('death_date', '=', False)]" />
                    <filter string="Deceased Authors" name="deceased"
                        domain="[('death_date', '!=', False)]" />
                    <separator />
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                    <group expand="0" string="Group By">
                        <filter string="Country" name="group_by_country"
                            context="{'group_by':'country'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action for author -->
        <record id="action_library_author" model="ir.actions.act_window">
            <field name="name">Authors</field>
            <field name="res_model">library.author</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_library_author_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first author
                </p>
                <p>
                    Track authors and their biographical information for your library.
                </p>
            </field>
        </record>

        <!-- Menu item for author -->
        <menuitem id="menu_library_author" name="Authors"
            parent="base.menu_custom" action="action_library_author" sequence="10" />
    </data>
</odoo>