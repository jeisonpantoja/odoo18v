<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for author-->
    <record id="view_library_author_tree" model="ir.ui.view">
        <field name="name">library.author.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="40%" />
                <field name="country" width="30%" />
                <field name="birth_date" />
                <field name="death_date" />
            </list>
        </field>
    </record>

    <!-- Form view for author-->
    <record id="view_library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form style="display: flex; justify-content: center;">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Author Name" />
                        </h1>
                    </div>
                    <group string="Main Information">
                        <group>
                            <field name="birth_date" />
                            <field name="death_date" />
                            <field name="country" />
                        </group>
                        <group>
                            <field name="partner_id" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Biography">
                            <field name="biography" placeholder="Brief biographical information" />
                        </page>
                        <!-- Books page removed until book_ids / books_count exist -->
                    </notebook>
                </sheet>
                <div class="oe_chatter" />
            </form>
        </field>
    </record>

    <!-- Search view (Filters) for author-->
    <record id="view_library_author_search" model="ir.ui.view">
        <field name="name">library.author.search</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="country" />
                <separator />
                <filter string="Living Authors" name="living"
                    domain="[('death_date','=',False)]" />
                <filter string="Deceased Authors" name="deceased"
                    domain="[('death_date','!=',False)]" />
                <separator />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_by_country"
                        context="{'group_by':'country'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for author -->

</odoo>